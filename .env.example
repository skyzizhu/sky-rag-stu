# ============================================================
# 个人知识库 RAG 配置文件
# 使用方法：把本文件复制一份，重命名为 .env，再填写下面的空值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，不会被开源出去，可以放心填 Key
# ============================================================

# ---------- 大模型（LLM）—— 云端或本地 Ollama 二选一 ----------
#
# 方式一：云端（任何 OpenAI 兼容服务商，需要 API Key）
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   Kimi:      LLM_BASE_URL=https://api.moonshot.cn/v1         LLM_MODEL=moonshot-v1-8k
#   智谱:      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#   通义:      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#
# 方式二：本地 Ollama（无需 API Key，数据完全不出本机，隐私优先）
#   先拉模型：ollama pull qwen3:14b（或你喜欢的其他模型）
#   然后填：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3:14b
#   LLM_API_KEY=ollama-local
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 回答的稳定程度（0 最严谨，1 最发散，知识库场景建议 0.1~0.3）
LLM_TEMPERATURE=0.2
# 单次回答的最大长度
LLM_MAX_TOKENS=8192

# ---------- 本地向量化模型（Ollama） ----------
# Ollama 服务地址（默认本机）
OLLAMA_URL=http://localhost:11434
# 向量化模型名（需已 ollama pull）
EMBEDDING_MODEL=qwen3-embedding:4b

# ---------- 向量数据库（Qdrant） ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=personal_knowledge

# ---------- 知识切片 ----------
# 每块知识的目标长度（中文字符数），建议 500~800
CHUNK_SIZE=640
# 相邻两块之间重复的长度（防止语义被切断），建议 80~150
CHUNK_OVERLAP=80

# ---------- 检索与回答 ----------
# 每次提问召回多少块知识
TOP_K=5
# 拼给大模型的资料上限（字符数），防止超出模型容量
CONTEXT_MAX_TOKENS=4000
# 同一文档最多进入回答的卡片数（保持来源多样）
CONTEXT_MAX_PER_DOC=3
# V2：Query 理解/改写（先用 LLM 把口语化提问改写成检索友好查询并推断过滤条件；
# 开启后每次问答多用一次 LLM 调用；true / false）
QUERY_UNDERSTANDING=true

# ---------- 其他 ----------
# 知识文件存放目录
KNOWLEDGE_DIR=knowledge
# 文件没有分类信息时的默认分类
DEFAULT_CATEGORY=未分类
# 调试模式（终端和页面打印更多过程信息：true / false）
DEBUG=true

# V2：混合检索（向量 + BM25 关键词两路召回，RRF 融合排序；true / false）
HYBRID_SEARCH=true

# V2：Rerank 精排（LLM 逐条打分；先宽召回再精选；true / false）
RERANK_ENABLED=true
# 精排后端：local_onnx（本地 bge-reranker-v2-m3 ONNX，CPU 离线零费用，需先下载模型：
#   python scripts/download_rerank_model.py）| llm（云端 LLM 逐条打分，默认）
# RERANK_BACKEND=local_onnx
# 0 使用 ONNX 默认线程策略；正整数限制精排计算线程（需同一批候选实测后选择）。
RERANK_THREADS=0
# 宽召回条数（精排前的候选池大小，需大于 TOP_K）
RERANK_RECALL_K=10

# 列举问题第一阶段：跨文档按文档精排，再展开内容；以下预算不等于完整性保证。
ENUM_RECALL_K=50
ENUM_CTX_ITEMS=40
ENUM_CTX_TOKENS=12000
ENUM_RERANK_DOCS=24
ENUM_EXPAND_DOCS=12
ENUM_DOC_CARDS=40
# 目录统计只读元数据，达到扫描/展示预算时返回 partial。
ENUM_CATALOG_DOCS=200
ENUM_CATALOG_POINTS=50000

# 列举第二阶段：生成模式启用分批条目提取与补查；MCP 仅证据模式不调用这些 LLM 步骤。
ENUM_STAGE2_ENABLED=true
ENUM_MAX_ROUNDS=2
ENUM_QUERIES_PER_ROUND=2
ENUM_NO_NEW_ROUNDS=2
ENUM_MAX_CALLS=12
ENUM_MAX_SECONDS=90
# 以下为阶段内模型输入+输出的估算 token 预算（不包含首轮检索/Query 理解/评估）。
ENUM_MAX_TOKENS=32000
ENUM_BATCH_TOKENS=3000
ENUM_OUTPUT_TOKENS=2048
ENUM_PAGE_CARDS=8
ENUM_MAX_CARDS=240
ENUM_MAX_DOCUMENTS=24
ENUM_MAX_ITEMS=120

# 单会话短期上下文：原始记录不删减；预算独立于检索资料 CONTEXT_MAX_TOKENS。
CHAT_CONTEXT_MAX_TOKENS=6000
CHAT_RECENT_TURNS=4
CHAT_SUMMARY_TOKENS=1200
# 仅新增且离开近期窗口的旧消息达到该阈值才压缩一次，不是每轮调用摘要模型。
CHAT_SUMMARY_TRIGGER_TOKENS=4000
CHAT_RECALL_MESSAGES=2

# V3.3：入库时 LLM 自动补全 topic/tags（true / false）
AUTO_TAG=true

# OCR（图片文件 / 扫描版 PDF / Word 与 PDF 内嵌图，RapidOCR 本地识别，中英文）：
# true = 入库时对图片内容做 OCR（CPU 运行，会略慢）；false = 跳过所有 OCR 环节
OCR_ENABLED=true

# 2026-11-27 格式体检：识别行置信度低于该值（0~1）的直接丢弃——低分行的内容基本
# 是识别噪声（实测一份真实汇报 PPT 有 25% 的识别行低于 0.8）。设为 0 关闭过滤。
OCR_MIN_CONFIDENCE=0.6

# 2026-11-28 决策3：单文件 OCR 时间预算（秒）。超时后跳过剩余图片，入库日志提示
# "N 张图片未识别"；0 = 不限制。入库全程串行，预算防止巨型文件占住入库队列。
OCR_TIME_BUDGET=120

# 2026-11-27 格式体检：入库前的提取质量体检（乱码字符/私用区字符/二进制空字节/
# PDF 空页占比）。疑似提取失败的文件默认不入库并在入库日志里说明原因；
# false = 恢复旧的"照常入库"行为。
EXTRACTION_GATE=true

# V3.9：MCP 双模配置——本服务对外暴露哪些工具
#   query  = 仅查询模式：只暴露 knowledge_search / knowledge_status（检索+筛选由 RAG 完成，拼装回答归调用方 Agent）
#   answer = 独立回答模式：暴露 knowledge_qa / knowledge_digest / knowledge_status（RAG 全管线含生成）
MCP_MODE=query
