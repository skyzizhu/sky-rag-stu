# ============================================================
# 个人知识库 RAG 配置文件
# 使用方法：把本文件复制一份，重命名为 .env，再填写下面的空值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，不会被开源出去，可以放心填 Key
# ============================================================

# ---------- 大模型（LLM）—— 云端或本地 Ollama 二选一 ----------
#
# 方式一：云端（任何 OpenAI 兼容服务商，需要 API Key）
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   Kimi:      LLM_BASE_URL=https://api.moonshot.cn/v1         LLM_MODEL=moonshot-v1-8k
#   智谱:      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#   通义:      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#
# 方式二：本地 Ollama（无需 API Key，数据完全不出本机，隐私优先）
#   先拉模型：ollama pull qwen3:14b（或你喜欢的其他模型）
#   然后填：
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3:14b
#   LLM_API_KEY=ollama-local
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 回答的稳定程度（0 最严谨，1 最发散，知识库场景建议 0.1~0.3）
LLM_TEMPERATURE=0.2
# 单次回答的最大长度
LLM_MAX_TOKENS=2000

# ---------- 本地向量化模型（Ollama） ----------
# Ollama 服务地址（默认本机）
OLLAMA_URL=http://localhost:11434
# 向量化模型名（需已 ollama pull）
EMBEDDING_MODEL=qwen3-embedding:4b

# ---------- 向量数据库（Qdrant） ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=personal_knowledge

# ---------- 知识切片 ----------
# 每块知识的目标长度（中文字符数），建议 500~800
CHUNK_SIZE=600
# 相邻两块之间重复的长度（防止语义被切断），建议 80~150
CHUNK_OVERLAP=100

# ---------- 检索与回答 ----------
# 每次提问召回多少块知识
TOP_K=5
# 拼给大模型的资料上限（字符数），防止超出模型容量
CONTEXT_MAX_TOKENS=4000
# 同一文档最多进入回答的卡片数（保持来源多样）
CONTEXT_MAX_PER_DOC=3
# V2：Query 理解/改写（先用 LLM 把口语化提问改写成检索友好查询并推断过滤条件；
# 开启后每次问答多用一次 LLM 调用；true / false）
QUERY_UNDERSTANDING=true

# ---------- 其他 ----------
# 知识文件存放目录
KNOWLEDGE_DIR=knowledge
# 文件没有分类信息时的默认分类
DEFAULT_CATEGORY=未分类
# 调试模式（终端和页面打印更多过程信息：true / false）
DEBUG=true

# V2：混合检索（向量 + BM25 关键词两路召回，RRF 融合排序；true / false）
HYBRID_SEARCH=true

# V2：Rerank 精排（LLM 逐条打分；先宽召回再精选；true / false）
RERANK_ENABLED=true
# 宽召回条数（精排前的候选池大小，需大于 TOP_K）
RERANK_RECALL_K=10

# V3.3：入库时 LLM 自动补全 topic/tags（true / false）
AUTO_TAG=true
